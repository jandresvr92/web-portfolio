# env
.env
.env.*
!.env.example

# logs
*.log
npm-debug.log*

node_modules
*.local

# build output: Nitro writes .output/ locally and .vercel/output/ with the
# Vercel preset; TanStack Start keeps its cache in .tanstack/.
dist
.output
.vercel
.nitro
.tanstack

# generated by the TanStack Router plugin on every dev/build run — never edit
src/routeTree.gen.ts

# editor
.vscode/*
!.vscode/extensions.json
.idea
.DS_Store
*.sw?

# temporary pages written by tools/render.mjs while it renders
tools/**/.*.filled.html
